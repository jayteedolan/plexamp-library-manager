# Copy to .env and adjust.  `id -u` / `id -g` give your user and group ids.
PUID=1000
PGID=1000
TZ=America/New_York
# Leave unset for Tailscale-only access (recommended). Set to 0.0.0.0 to reach the web UI over
# plain HTTP from other devices on your LAN before Tailscale is set up -- switch back afterwards.
APP_BIND=127.0.0.1

# The USB drive and the folders on it (host paths; mounted at the same paths in the container).
USB_ROOT=/mnt/usb
LIBRARY_ROOT=/mnt/usb/Music
STAGING_ROOT=/mnt/usb/.lm/staging
TRASH_ROOT=/mnt/usb/.lm/trash
# Writes are refused unless this file exists, so nothing is written to the SD card if the drive is unplugged.
MOUNT_MARKER=/mnt/usb/.lm/.lm-root

# slskd. Use http://slskd:5030 when slskd runs from this compose file, or
# http://host.docker.internal:5030 when it is installed natively on the Pi.
SLSKD_URL=http://host.docker.internal:5030
SLSKD_API_KEY=change-me-to-a-long-random-string
# Only used by the optional slskd container:
SOULSEEK_USERNAME=
SOULSEEK_PASSWORD=

# Plex (installed natively on the Pi). Token: see docs/SETUP.md. These can also be set in the app's Settings page.
PLEX_URL=http://host.docker.internal:32400
PLEX_TOKEN=
PLEX_SECTION_ID=
PLEX_LIBRARY_PATH=/mnt/usb/Music

TRASH_RETENTION_DAYS=30
# Tailscale Serve provides HTTPS, so session cookies are marked Secure. Set false only for plain-HTTP testing.
COOKIE_SECURE=true
# The login page and single admin account. Turn off only if this instance is already behind its
# own access control you trust (e.g. Tailscale-only, a reverse proxy with its own auth) -- with
# this false, anything that can reach the container can use the app without signing in.
AUTH_ENABLED=true
